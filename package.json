{
  "name": "ember",
  "version": "1.2.0",
  "description": "A terminal for working alongside coding agents — Claude Code, Codex, Gemini, Cursor, OpenCode, Copilot. No API keys.",
  "license": "MIT",
  "homepage": "https://ember.deepanswerlabs.com",
  "repository": "github:afetiu/ember-terminal",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": {
    "name": "Deep Answer Labs"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "node scripts/prepare-resources.mjs && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "node scripts/icon/from-png.mjs build/logo-source.png",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.14",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "elkjs": "0.12.0",
    "mermaid": "^11.17.2",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
