# Cloudflare Pages response headers for ember.deepanswerlabs.com

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'; upgrade-insecure-requests

# HTML: always revalidate so a release (new version string, new copy) shows up at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/docs
  Cache-Control: public, max-age=0, must-revalidate
/docs.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS/JS are not fingerprinted (no build step), so keep them short-lived; Cloudflare
# still serves them from the edge and revalidates with ETags.
/*.css
  Cache-Control: public, max-age=3600, must-revalidate
/*.js
  Cache-Control: public, max-age=3600, must-revalidate

# Images change rarely; a day in browsers, a week at the edge.
/assets/*
  Cache-Control: public, max-age=86400, s-maxage=604800

# The terminal installer: plain text, so `irm … | iex` reads it as a script.
/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300, must-revalidate

# (Nothing for /download/*: those are answered by _redirects with a 302, which
# browsers don't cache without explicit headers.)

# The phone app (docs/specs/phone.md). Its own policy instead of the site's: it talks to
# the relay over a WebSocket, shows media as blob: URLs, and renders Claude's documents in
# sandboxed srcdoc frames, which inherit this policy and carry inline scripts and styles.
# Those frames have no origin, so they cannot reach this page or the account key.
/app/*
  ! Content-Security-Policy
  ! Permissions-Policy
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src blob:; connect-src 'self' https://*.workers.dev wss://*.workers.dev; frame-src 'self'; worker-src 'self' blob:; base-uri 'self'; object-src 'none'; frame-ancestors 'none'
  Cache-Control: public, max-age=0, must-revalidate

# Libraries the phone's object frames load; those frames have no origin, so this is CORS.
/vendor/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
